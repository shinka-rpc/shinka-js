{
  "compilerOptions": {
    "target": "es2025",
    "module": "es2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2021",
      "ES2022",
      "ES2025",
      "ESNext.Disposable"
    ],
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  "exclude": [
    // "**/*.test.ts",
    // "**/*.stub.ts",
    "node_modules/",
    "dist/",
    "**/__tests__/",
    "**/jest.config.ts"
  ]
}
