{
  "compilerOptions": {
    "target": "es2022",
    "module": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2021", "ES2022", "ESNext.Disposable"],
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  "exclude": [
    // "**/*.test.ts",
    // "**/*.stub.ts",
    "node_modules/",
    "dist/",
    "**/__tests__/",
    "**/jest.config.ts"
  ]
}
