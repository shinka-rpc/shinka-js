{
  "version": "0.1.0",
  "description": "Symmetric RPC bus",
  "main": "index.js",
  "scripts": {
    "graph": "nx graph",
    "build": "lerna run --scope \"@shinka-rpc/*\" build",
    "prebuild": "rm -rf dist/*",
    "test": "lerna run --scope \"@shinka-rpc/*\" test",
    "packall": "D=\"$PWD\"; mkdir -p pack && rm -f pack/*; for d in dist/*; do cd \"$d\"; npm pack --pack-destination \"$D\"/pack; cd \"$D\"; done",
    "prepublishall": "npm run build",
    "publishall": "node publishAll.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinka-rpc/shinka-js.git"
  },
  "keywords": [
    "rpc",
    "background",
    "worker",
    "websocket",
    "communication",
    "remote"
  ],
  "author": "AI Kavalevich",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shinka-rpc/shinka-js/issues"
  },
  "homepage": "https://github.com/shinka-rpc/shinka-js",
  "dependencies": {
    "@kai3341/bsonfy": "^1",
    "@msgpack/msgpack": "^3",
    "@types/chrome": "*",
    "@types/js-yaml": "*",
    "@types/node": "*",
    "@types/pako": "*",
    "@types/react": "^19.2.18",
    "@types/ws": "*",
    "js-yaml": "^5",
    "lerna": "^10",
    "pako": "^2"
  },
  "devDependencies": {
    "@jest/globals": "^29",
    "@swc/jest": "^0.2.39",
    "jest": "^30",
    "mermaid": "^11",
    "nx": "^23.1.2",
    "typescript": "^7",
    "vitepress": "next",
    "vitepress-plugin-mermaid": "^2"
  },
  "overrides": {
    "vitepress-plugin-mermaid": {
      "vitepress": "$vitepress"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.1": true,
    "unrs-resolver@1.12.2": true,
    "nx@23.2.0": true
  }
}
